# Copy to checkins/.env (gitignored) and fill in. Never paste keys into chat.

# Model calls: one key is enough. If the census's .env (one folder up) has CENSUS_ANTHROPIC_API_KEY,
# check-ins uses it and you can leave both of these blank.
ANTHROPIC_API_KEY=
# Optional: route through Nicrron instead (OpenAI format; Claude IDs are anthropic/<model>).
NICRRON_API_KEY=
NICRRON_MODEL=anthropic/claude-opus-5-5

# Roundtable: one "AI assistant -> Custom" key per workspace. The fund and the startup are
# different workspaces (different emails); on one laptop you can set both.
ROUNDTABLE_VC_KEY=
ROUNDTABLE_STARTUP_KEY=

# PRISM tracing (Block Convey). Off while the key is blank. Bump the version for each fix so
# PRISM compares runs: the agents report as checkins-<agent>-<version>.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=c84720c1-f793-4480-b4f1-30f78f71a1c4
CHECKINS_AGENT_VERSION=v1

# akta (Wokelo): live news and headcount for companies with a real domain.
AKTA_API_KEY=

# Who approves on the startup side.
FOUNDER_NAME=Dana Okafor
# off = always call the model (use for PRISM runs); default caches replies for repeatable demos.
CHECKINS_CACHE=
