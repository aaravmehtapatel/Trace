# Copy to .env (gitignored) and fill in.
SEC_USER_AGENT="Your Name you@yourdomain.com"
# Optional: live Claude domain proposals. Without it, config/domain_hints.json is used.
CENSUS_ANTHROPIC_API_KEY=
# Optional: trace the Claude calls to PRISM (needs `pip install prismtrace-sdk`). Off while the key is blank.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=c84720c1-f793-4480-b4f1-30f78f71a1c4
PRISMTRACE_HOST=https://api.prism.blockconvey.com
# Akta (Wokelo) licensed news and headcount. Headcount needs a subscription plan.
AKTA_API_KEY=
